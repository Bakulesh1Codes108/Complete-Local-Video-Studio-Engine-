{
  "name": "complete-local-video-studio-engine",
  "version": "1.5.0",
  "description": "Unified Video Studio Engine & Antigravity Video Studio — 100% Free, Code-Driven AI Video & Reel Studio with Multi-Engine (Remotion, Three.js, Blender, Manim), Open Higgsfield Rigs, Vertical V3, Reel Mimic, Zero-Shot Voice Cloning & RPA",
  "keywords": [
    "unified-video-studio",
    "video-studio-engine",
    "antigravity",
    "remotion",
    "ai-video-generator",
    "vertical-video",
    "blender-3d",
    "threejs",
    "higgsfield",
    "voice-cloning",
    "shorts-automation",
    "manim",
    "ffmpeg",
    "losslesscut",
    "pyscenedetect"
  ],
  "scripts": {
    "preview": "remotion preview src/index.ts",
    "render": "remotion render src/index.ts Documentary out/documentary.mp4",
    "build": "remotion bundle src/index.ts",
    "typecheck": "tsc --noEmit",
    "advisor": "python3 scripts/studio.py advisor",
    "quickstart": "python3 scripts/studio.py quickstart",
    "memory:status": "python3 scripts/studio.py status",
    "voiceover:generate": "python3 scripts/studio.py audio"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0",
    "@remotion/player": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0"
  }
}
